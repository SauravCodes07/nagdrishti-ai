# ==============================================================================
# NagDrishti AI — Frontend Environment Configuration Example
# Copy this file to frontend/.env.local and populate with your credentials.
# NEVER commit .env.local with production secrets to version control.
# ==============================================================================

# Base URL of the deployed Django backend API on Render
NEXT_PUBLIC_API_URL=https://nagdrishti-ai-backend.onrender.com

# For local development with local Django server:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Production site URL on Vercel
NEXT_PUBLIC_SITE_URL=https://nagdrishti-ai.vercel.app

# Supabase Project URL & Keys
# Obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://nitrixvlhcinqccjhccp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
