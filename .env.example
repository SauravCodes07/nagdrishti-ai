# ============================================================
# NAGDRISHTI AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit secrets.
# ============================================================

# --- Mapbox Vector GIS Map (Optional: falls back to Carto & Esri Satellite if omitted) ---
VITE_MAPBOX_TOKEN=

# --- Open-Meteo Weather API (Default public endpoint used directly) ---
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# --- Backend GeoAI & FastAPI Service ---
VITE_BACKEND_API_URL=http://localhost:8000

# --- Supabase PostgreSQL + PostGIS Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Google Earth Engine (Server-side only) ---
EARTH_ENGINE_PROJECT=nagdrishti-ai-geospatial
EARTH_ENGINE_SERVICE_ACCOUNT=service-account@nagdrishti-ai.iam.gserviceaccount.com
EARTH_ENGINE_KEY_FILE=./service-account-key.json

# --- Hugging Face Hub (Prithvi EO Foundation Models) ---
HUGGINGFACE_TOKEN=
PRITHVI_MODEL_ID=ibm-nasa-geospatial/Prithvi-EO-1.0-100M

# --- Traffic API Provider (Optional: falls back to simulation mode) ---
TRAFFIC_API_KEY=
