# ==============================================================================
# NagDrishti AI — Backend Environment Configuration Example
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,.onrender.com

# ------------------------------------------------------------------------------
# Supabase PostgreSQL + PostGIS Database Configuration
# Obtain from Supabase Project Settings -> Database -> Connection Parameters / Pooler
# ------------------------------------------------------------------------------
# Direct host or Supavisor Session Pooler (e.g. aws-0-ap-southeast-1.pooler.supabase.com):
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-supabase-project-ref
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_DB_PORT=5432
SUPABASE_DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Hugging Face Serverless Vision Inference API
# Token with Inference permissions from https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HUGGINGFACE_API_TOKEN=hf_your_hugging_face_api_token_here
HF_DETECTION_MODEL_URL=https://api-inference.huggingface.co/models/openai/clip-vit-base-patch32

# ------------------------------------------------------------------------------
# Twilio Emergency Alert Service (SMS / WhatsApp)
# Credentials from https://console.twilio.com
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+919876543210

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID (Sign in with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application
# Add frontend origin (e.g. http://localhost:3000, https://nagdrishti-ai.vercel.app) to Authorized JavaScript origins
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# Comma-separated list of authorized frontend origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nagdrishti-ai.vercel.app,https://nagdrishti.netlify.app
