# Copy this file to .env and fill in real values. NEVER commit .env to git.

DJANGO_SECRET_KEY=generate-a-real-random-value-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# From Supabase project settings -> Database -> Connection info
SUPABASE_DB_HOST=
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_PORT=5432

# Next.js dev server origin, comma-separated if more than one
CORS_ALLOWED_ORIGINS=http://localhost:3000
